# Public Supabase values used by the browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only credential; never expose this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Twilio server-only request validation secret
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token

# Exact public webhook URL configured in the Twilio Console
TWILIO_VOICE_WEBHOOK_URL=https://your-domain.example/api/webhooks/twilio/voice

# Vapi server-only credentials and resource IDs
VAPI_PRIVATE_API_KEY=replace-with-vapi-private-key
VAPI_PHONE_NUMBER_ID=replace-with-vapi-phone-number-id
VAPI_ASSISTANT_ID=replace-with-vapi-assistant-id