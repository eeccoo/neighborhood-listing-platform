{
  "$id": "https://example.com/schemas/property-collection.schema.json",
  "title": "Synthetic Property Collection",
  "description": "Five fictional property records validated before entering the UI or database.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 5,
  "maxItems": 5,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "property_id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 3
      },
      "street_address": {
        "type": "string",
        "minLength": 5
      },
      "city": {
        "type": "string",
        "minLength": 2
      },
      "state": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "zip_code": {
        "type": "string",
        "pattern": "^\\d{5}$"
      },
      "price": {
        "type": "number",
        "minimum": 0
      },
      "bedrooms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "bathrooms": {
        "type": "number",
        "minimum": 0
      },
      "square_feet": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "property_type": {
        "type": "string",
        "enum": [
          "single-family",
          "condo",
          "townhouse",
          "multi-family",
          "apartment"
        ]
      },
      "image_path": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^\\/.*"
      },
      "details_url": {
        "type": "string",
        "format": "starts_with",
        "pattern": "^\\/.*"
      },
      "amenities": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "accessible-entry",
            "air-conditioning",
            "laundry",
            "parking",
            "pet-friendly",
            "pool"
          ]
        }
      },
      "local_sponsors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sponsor_id": {
              "type": "string",
              "minLength": 1
            },
            "business_name": {
              "type": "string",
              "minLength": 2
            },
            "short_description": {
              "type": "string",
              "minLength": 10
            },
            "destination_url": {
              "type": "string",
              "format": "uri"
            },
            "category": {
              "type": "string",
              "enum": [
                "community",
                "finance",
                "food-and-drink",
                "health-and-wellness",
                "home-services"
              ]
            },
            "sponsored_label": {
              "type": "string",
              "const": "Sponsored"
            },
            "is_active": {
              "type": "boolean"
            }
          },
          "required": [
            "sponsor_id",
            "business_name",
            "short_description",
            "destination_url",
            "category",
            "sponsored_label",
            "is_active"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "property_id",
      "title",
      "street_address",
      "city",
      "state",
      "zip_code",
      "price",
      "bedrooms",
      "bathrooms",
      "square_feet",
      "property_type",
      "image_path",
      "details_url",
      "amenities",
      "local_sponsors"
    ],
    "additionalProperties": false
  }
}
